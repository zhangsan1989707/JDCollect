{
  "manifest_version": 3,
  "name": "JD Collector - 职位采集助手",
  "version": "2.0.0",
  "description": "半自动采集BOSS直聘、猎聘、拉勾、智联招聘等主流招聘网站上的职位信息，支持批量导出CSV、飞书同步、投递管理。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.zhipin.com/*",
    "https://*.liepin.com/*",
    "https://*.lagou.com/*",
    "https://*.zhaopin.com/*",
    "https://open.feishu.cn/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon48.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://*.liepin.com/*",
        "https://*.lagou.com/*",
        "https://*.zhaopin.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon48.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
